# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# deploy credentials — must never be committed; see docs/deployment.md.
# The real key lives outside this repo (~/.ssh/eardle_deploy), this is just
# a defensive backstop in case one is ever dropped in the repo by mistake.
id_ed25519*
id_rsa*
*_deploy
*_deploy.pub

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite remnants (app now uses PostgreSQL)
*.db
*.db-shm
*.db-wal

# Claude Code local project config — settings.local.json and launch.json are
# machine-specific (settings.local.json has held a literal local-dev DB
# password in a permission-allowlist entry before — see the 2026-08-11
# audit); worktrees/ is local scratch. settings.json (if it ever exists) is
# the one file meant to be shared/tracked, so it's explicitly un-ignored.
.claude/*
!.claude/settings.json

# Internal security/bug audit reports — real infra details and (patched but
# still illustrative) exploit chains; must never reach the public repo.
security-audit*.md

# Ad hoc auth-flow testing artifacts (curl/response dumps) — these have
# transiently held live, unexpired session-token cookies during testing
# before; never let them accumulate in the working tree unprotected.
*cookies.txt
*_resp.txt
