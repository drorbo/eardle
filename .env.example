# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Next.js auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me

# Google OAuth (optional — leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jam Gym (jam-gym.eardle.com) "Sign in with eardle": the secret shared with Jam Gym's EARDLE_SSO_SECRET. Leave blank to switch
# the integration off. Generate with: openssl rand -base64 32   (see docs/jam-gym-integration.md)
JAMGYM_SSO_SECRET=
# Where /jam-gym/authorize sends people back to. Defaults to production; use http://localhost:5173 for a local Jam Gym.
JAMGYM_URL=

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
